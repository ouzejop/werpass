{
  "name": "@werpass/mobile",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules",
        "../../node_modules"
      ]
    }
  },
  "scripts": {
    "start": "expo start --go --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/demo.test.mjs",
    "demo:reset": "node scripts/reset-demo.mjs"
  },
  "dependencies": {
    "expo": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-localization": "^57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-svg": "^15.15.5",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.17"
  }
}
