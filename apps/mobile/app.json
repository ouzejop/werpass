{
  "expo": {
    "name": "WérPass",
    "slug": "werpass",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      "expo-sqlite"
