# Copier uniquement cette section dans apps/mobile/.env.local.
# Valeurs publiques embarquables dans les clients
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_MODE=true

# Valeurs serveur uniquement — à enregistrer avec `supabase secrets set`.
# Ne jamais les copier dans apps/mobile/.env.local ni les préfixer EXPO_PUBLIC_ ou VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
MEDICAL_CODE_PEPPER=
# Démo seulement : affiche le code médical dans l'application après la demande médecin.
# Ne jamais activer cette option dans un environnement réel.
DEMO_IN_APP_CODE_DISPLAY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
